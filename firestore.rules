rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anonymous users to read and write to scoreboard
    match /scoreboard/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow anonymous users to read and write to player_stats
    // Analytics queries need to read all documents for aggregation
    match /player_stats/{document=**} {
      allow read: if true;  // Allow reading for analytics
      allow write: if request.auth != null;
    }

    // Allow anonymous users to manage player names
    match /player_names/{document=**} {
      allow read: if true;  // Anyone can check name availability
      allow create: if request.auth != null;  // Authenticated users can reserve names
      allow update: if request.auth != null;  // Authenticated users can update names
      allow delete: if request.auth != null;  // Authenticated users can release names
    }

    // Allow authenticated users to manage their own user object and analytics
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to read/write their own analytics
      match /analytics/{analyticsDoc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Global analytics collection (hybrid approach - also writing to user-scoped for audit)
    match /analytics/{document=**} {
      allow read: if true;  // Anyone can read global analytics for leaderboards
      allow write: if request.auth != null;  // Authenticated users can contribute to global stats
    }
  }
}