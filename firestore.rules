rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anonymous users to read and write to scoreboard
    match /scoreboard/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow anonymous users to read and write to player_stats
    // Analytics queries need to read all documents for aggregation
    match /player_stats/{document=**} {
      allow read: if true;  // Allow reading for analytics
      allow write: if request.auth != null;
    }
    
    // Allow anonymous users to manage player names
    match /player_names/{document=**} {
      allow read: if true;  // Anyone can check name availability
      allow create: if request.auth != null;  // Authenticated users can reserve names
      allow update: if request.auth != null;  // Authenticated users can update names
      allow delete: if request.auth != null;  // Authenticated users can release names
    }
  }
}