# EAS ignore — used INSTEAD of .gitignore when present.
# Keep in sync with .gitignore PLUS extra exclusions for the EAS upload.

# === git directory (535 MB of history, NOT needed by build server) ===
.git/
.gitignore
.gitattributes

# === everything from .gitignore ===
node_modules/
.expo/
dist/
web-build/
docs-site/build/
docs-site/.docusaurus/
docs-site/node_modules/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.ipa
*.aab
*.apk
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
app-example

# === EAS-specific extras (NOT in .gitignore, but useless for the build) ===

# Entire docs-site project — separate Docusaurus site, not part of the mobile app
docs-site/

# Local Xcode / CocoaPods artifacts (EAS reinstalls pods server-side)
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# Local Android / Gradle artifacts (EAS rebuilds server-side)
android/build/
android/.gradle/
android/.cxx/
android/app/build/
android/local.properties

# Test / coverage output
coverage/

# Backup folder of original emoji PNGs — kept locally only
assets/images/emojis.bak/

# Source icon files (only the built/exported ones in assets/ go in the bundle)
AppIcons/

# Logs and one-off zips
*.log
build.log
Archive.zip

# Planning docs that don't need to ship
*_PLAN.md
*_SUMMARY.md
*_GUIDE.md
PR_*.md
EMOJI_MIGRATION_PLAN.md
JOKER_EVENT_COMPATIBILITY_REVIEW.md
JOKER_SYSTEM_GUIDE.md
PIXEL_BORDER_MIGRATION_GUIDE.md
PERFORMANCE_TESTING.md
PERFORMANCE_OPTIMIZATION_GUIDE.md
ADMOB_PERFORMANCE_OPTIMIZATION_SUMMARY.md
EVENT_SYSTEM_REVAMP_SUMMARY.md
HOW_TO_ADD_EVENTS_SIMPLIFIED.md
FIXES_SUMMARY.md
PR_NOTES.md
COLOR_CATALOG.md

# Sim output (generated by scripts/balanceCalc.ts and scripts/simulateGame.ts)
scripts/output/
